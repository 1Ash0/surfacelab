# Copy to .env (git-ignored) and fill in only the providers you use.
# Free tiers only (ADR-021). Leave a line empty to skip that provider.
# Never paste a key into chat, a commit, an issue or a log.

# https://openrouter.ai/keys  (use models whose id ends in :free)
OPENROUTER_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey  (unpaid quota: Google may use prompts to improve products)
GEMINI_API_KEY=

# https://build.nvidia.com  (trial: testing and evaluation only)
NVIDIA_API_KEY=

MISTRAL_API_KEY=
